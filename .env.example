# Copy to .env and adjust. Every value is optional.

# Port the API (and, after `npm run build`, the web app) listens on.
PORT=4000

# Where the SQLite database (ninre.sqlite) and uploaded photos are kept.
# Point this at a persistent disk when you deploy.
DATA_DIR=./data

# Public address of the site, used in PayMongo's return links. When empty it is
# taken from each request, which is fine behind a proxy that keeps the Host header.
APP_URL=

# PayMongo secret key (sk_test_… or sk_live_…). Leave empty to use the labelled
# test checkout, where no money moves.
PAYMONGO_SECRET_KEY=

# Secret of the PayMongo webhook that points at /api/billing/webhook and listens
# for checkout_session.payment.paid. Without it, webhooks are refused and
# payments are confirmed when people return from checkout.
PAYMONGO_WEBHOOK_SECRET=

# Payment methods offered at checkout. They must be enabled on your PayMongo account.
PAYMONGO_METHODS=card,gcash,paymaya
